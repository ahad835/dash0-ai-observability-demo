# Copy this file to .env and fill in your own values:  cp .env.example .env

# Dash0 OTLP endpoint for YOUR org's region (Dash0 → Organization Settings → Endpoints → OTLP via HTTP)
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com

# Dash0 auth token with "Ingest" permission (Dash0 → Organization Settings → Auth Tokens). Starts with auth_
DASH0_AUTH_TOKEN=auth_REPLACE_ME

# Dash0 dataset to send data to
DASH0_DATASET=default
